      "parameters": {
        "jsCode": "// Junta telefone + boleto + dados de regra e monta uma das 3 mensagens.\n// IMPORTANTE: quando não dá para enviar (sem telefone ou sem boleto), NÃO usamos return [].\n// Devolvemos um item sinalizado (semEnvio: true) para um node IF desviar direto ao Wait,\n// assim o Loop Over Items continua e os próximos clientes não ficam sem processar.\nconst dadosPessoa = $json;\nlet telefone = dadosPessoa.telefone_celular || dadosPessoa.telefone_comercial;\n\nif (telefone) {\n  telefone = String(telefone).replace(/\\D/g, '');\n  if (!telefone.startsWith('55')) {\n    telefone = '55' + telefone;\n  }\n}\n\nconst dadosRegra = $('Aplicar Regras de Cobrança Mario').item.json;\nconst dadosBoleto = $('Consolidar Boleto Mario').item.json;\n\nconst resumoSolicitacoes = (Array.isArray(dadosBoleto.solicitacoes_cobrancas) ? dadosBoleto.solicitacoes_cobrancas : [])\n  .map((s) => `${s.tipo_solicitacao_cobranca}/${s.status_solicitacao_cobranca}`);\n\nconst semEnvio = (motivo) => [{\n  json: {\n    semEnvio: true,\n    motivo,\n    detalhe: {\n      metodo_pagamento: dadosBoleto.metodo_pagamento || null,\n      agendado: dadosBoleto.evento?.agendado ?? null,\n      solicitacoes: resumoSolicitacoes,\n    },\n    cliente: dadosRegra.cliente,\n    empreendimento: dadosRegra.empreendimento,\n    parcelaId: dadosRegra.parcelaId,\n  },\n}];\n\n// Falha de API nos nodes de busca (quando On Error está em Continue)\nif (dadosPessoa.error || dadosBoleto.error) {\n  return semEnvio('ERRO_API');\n}\n\n// Trava: se a parcela já foi paga (dado atualizado do getInstallmentById), não envia nada.\n// Confirmado no JSON real: status vem em português (ex.: ATRASADO) e existe o campo nao_pago.\nconst statusParcela = String(dadosBoleto.status || '').toUpperCase();\nconst STATUS_PAGO = ['RECEBIDO', 'QUITADO', 'PAGO', 'ACQUITTED', 'PAID', 'RECEIVED'];\nconst naoPagoAtual = dadosBoleto.nao_pago !== undefined ? Number(dadosBoleto.nao_pago) : null;\nif (STATUS_PAGO.includes(statusParcela) || (naoPagoAtual !== null && naoPagoAtual <= 0)) {\n  return semEnvio('JA_PAGO');\n}\n\nif (!telefone) {\n  return semEnvio('SEM_TELEFONE');\n}\n\nconst solicitacoes = Array.isArray(dadosBoleto.solicitacoes_cobrancas) ? dadosBoleto.solicitacoes_cobrancas : [];\nconst solicitacaoBoleto = [...solicitacoes].reverse().find(\n  (s) => s.tipo_solicitacao_cobranca === 'BOLETO' && s.status_solicitacao_cobranca === 'REGISTRADO'\n);\nconst linkBoleto = solicitacaoBoleto?.url || null;\n\nif (!linkBoleto) {\n  if (dadosBoleto.evento?.agendado === true) return semEnvio('VENDA_AGENDADA');\n  // Cobrança existe mas o banco recusou (ex.: endereço do cliente incompleto no Conta Azul)\n  if (solicitacoes.some((s) => s.tipo_solicitacao_cobranca === 'BOLETO' && s.status_solicitacao_cobranca === 'INVALIDO')) {\n    return semEnvio('BOLETO_INVALIDO');\n  }\n  // Boleto gerado mas ainda não registrado no banco\n  if (solicitacoes.some((s) => s.tipo_solicitacao_cobranca === 'BOLETO' && s.status_solicitacao_cobranca === 'AGUARDANDO_CONFIRMACAO')) {\n    return semEnvio('BOLETO_AGUARDANDO_REGISTRO');\n  }\n  return semEnvio('SEM_BOLETO');\n}\n\nconst dataFormatada = dadosRegra.dataVencimento;\nconst valorFormatado = Number(dadosRegra.valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\n\nlet mensagem;\n\nif (dadosRegra.tipoMensagem === 'ENVIO_BOLETO') {\n  mensagem = `Prezado(a) cliente,\\n\\nSegue o boleto referente ao empreendimento *${dadosRegra.empreendimento}*, com vencimento em ${dataFormatada}, no valor de ${valorFormatado}.\\n\\nSegue abaixo o link para acesso ao boleto:\\n${linkBoleto}\\n\\nEm caso de dúvidas, permanecemos à disposição.`;\n} else if (dadosRegra.tipoMensagem === 'LEMBRETE_VENCIMENTO') {\n  mensagem = `Prezado(a) cliente,\\n\\nEste é um lembrete de que o boleto referente ao empreendimento *${dadosRegra.empreendimento}* vence hoje, dia ${dataFormatada}, no valor de ${valorFormatado}.\\n\\nSegue abaixo o link para acesso ao boleto:\\n${linkBoleto}\\n\\nSolicitamos a gentileza de efetuar o pagamento ainda hoje, evitando assim a incidência de juros e multa por atraso.\\n\\nEm caso de dúvidas, permanecemos à disposição.`;\n} else {\n  mensagem = `Prezado(a) cliente,\\n\\nIdentificamos que o boleto referente ao empreendimento *${dadosRegra.empreendimento}*, com vencimento em ${dataFormatada}, no valor de ${valorFormatado}, ainda consta em aberto em nosso sistema.\\n\\nSegue abaixo o link para acesso ao boleto:\\n${linkBoleto}\\n\\nSolicitamos a gentileza de regularizar o quanto antes, para evitar a incidência de juros e multa adicionais.\\n\\nCaso o pagamento já tenha sido efetuado, por favor desconsidere esta mensagem.\\n\\nEm caso de dúvidas, permanecemos à disposição.`;\n}\n\nconst templates = {\n  ENVIO_BOLETO: 'cobranca_envio_boleto',\n  LEMBRETE_VENCIMENTO: 'cobranca_lembrete_vencimento',\n  COBRANCA_ATRASO: 'cobranca_atraso',\n};\n\nreturn [{\n  json: {\n    semEnvio: false,\n    cliente: dadosRegra.cliente,\n    telefone,\n    empreendimento: dadosRegra.empreendimento,\n    tipoMensagem: dadosRegra.tipoMensagem,\n    linkBoleto,\n    mensagem,\n    template: templates[dadosRegra.tipoMensagem] || 'cobranca_atraso',\n    parametros: [\n      String(dadosRegra.empreendimento).replace(/\\s+/g, ' ').trim(),\n      dataFormatada,\n      valorFormatado.replace(/\\u00a0/g, ' '),\n      linkBoleto,\n    ],\n  },\n}];"
      },
