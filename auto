      "parameters": {
        "jsCode": "const registros = $input.all();\nconst NOME_EMPRESA = \"Mario Leonardi\";\n\nif (registros.length === 0 || !registros[0].json.empreendimento) {\n  return [{ json: { mensagem: \"Fechamento da Semana - Cobranças (\" + NOME_EMPRESA + \")\\n\\nNesta semana não tivemos disparos de cobrança por aqui.\", temDados: false } }];\n}\n\nconst LABELS_TIPO = {\n  'ENVIO_BOLETO': 'Envio de boleto',\n  'LEMBRETE_VENCIMENTO': 'Lembrete de vencimento',\n  'COBRANCA_ATRASO': 'Cobrança de atraso',\n};\n\n// Agrupa por curso (empreendimento)\nconst porCurso = {};\nlet totalGeralMensagens = 0;\nlet totalGeralValor = 0;\nlet dataInicioGeral = null;\nlet dataFimGeral = null;\n\nregistros.forEach(item => {\n  const curso = item.json.empreendimento || 'SEM CURSO IDENTIFICADO';\n  const tipo = LABELS_TIPO[item.json.tipo_lembrete] || item.json.tipo_lembrete;\n  const dataVenc = item.json.data_vencimento;\n  const qtd = Number(item.json.quantidade);\n  const valor = Number(item.json.valor_total);\n\n  if (!porCurso[curso]) {\n    porCurso[curso] = { linhas: [], subtotalQtd: 0, subtotalValor: 0 };\n  }\n\n  porCurso[curso].linhas.push({ tipo, dataVenc, qtd, valor });\n  porCurso[curso].subtotalQtd += qtd;\n  porCurso[curso].subtotalValor += valor;\n\n  totalGeralMensagens += qtd;\n  totalGeralValor += valor;\n\n  if (item.json.data_inicio) {\n    const inicioItem = new Date(item.json.data_inicio);\n    if (!dataInicioGeral || inicioItem < dataInicioGeral) dataInicioGeral = inicioItem;\n  }\n  if (item.json.data_fim) {\n    const fimItem = new Date(item.json.data_fim);\n    if (!dataFimGeral || fimItem > dataFimGeral) dataFimGeral = fimItem;\n  }\n});\n\nconst formatarData = (data) => data.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });\n\nlet periodoTexto = \"período não identificado\";\nif (dataInicioGeral && dataFimGeral) {\n  periodoTexto = formatarData(dataInicioGeral) === formatarData(dataFimGeral)\n    ? formatarData(dataInicioGeral)\n    : formatarData(dataInicioGeral) + \" a \" + formatarData(dataFimGeral);\n}\n\nconst formatarMoeda = (valor) => Number(valor).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n\nlet blocoCursos = \"\";\nObject.keys(porCurso).sort().forEach(curso => {\n  const dadosCurso = porCurso[curso];\n  blocoCursos += `\\n\\n*${curso}*`;\n  dadosCurso.linhas.forEach(linha => {\n    blocoCursos += `\\n- ${linha.tipo} (venc. ${linha.dataVenc}): ${linha.qtd}x (R$ ${formatarMoeda(linha.valor)})`;\n  });\n  blocoCursos += `\\nSubtotal: ${dadosCurso.subtotalQtd}x - R$ ${formatarMoeda(dadosCurso.subtotalValor)}`;\n});\n\nconst textoFinal = \"Fechamento Semanal | Cobranças \" + NOME_EMPRESA + \"\\n\\n\" +\n\"Período dos disparos: \" + periodoTexto + \"\\n\\n\" +\n\"Segue o resumo dos disparos automáticos desta semana, por curso:\" +\nblocoCursos +\n\"\\n\\nTotal geral: \" + totalGeralMensagens + \" mensagens - R$ \" + formatarMoeda(totalGeralValor) +\n\"\\n\\nBase limpa e pronta para a próxima semana.\";\n\nreturn [{ json: { mensagem: textoFinal, temDados: true } }];"
      },
