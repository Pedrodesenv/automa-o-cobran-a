      "parameters": {
        "jsCode": "// =====================================================================\n// REGRAS DE COBRANÇA - MARIO LEONARDI (VERSÃO DE PRODUÇÃO)\n// Fluxo: Disparo 8h -> Historico Ja Enviados Mario (Postgres) -> Buscar Contas a Receber -> ESTE node\n//\n// 3 mensagens, só para parcelas ainda não pagas:\n//   ENVIO_BOLETO        = 5 dias antes do vencimento (se não sair, tenta de novo nos 4 dias seguintes)\n//   LEMBRETE_VENCIMENTO = no dia do vencimento\n//   COBRANCA_ATRASO     = 1 dia depois do vencimento\n// Cada mensagem só sai UMA vez por cliente + empreendimento + vencimento (confere o histórico).\n// =====================================================================\nconst DIAS_ANTES = 5;          // dia do 1º envio do boleto\nconst DIAS_RETENTATIVA = 4;    // janela do boleto: 5, 4, 3, 2 e 1 dia antes. NÃO usar 5 (pegaria o dia 0 como boleto e quebraria o lembrete).\nconst MAX_POR_EXECUCAO = 40;   // teto de mensagens por dia (protege o número de WhatsApp)\n\n// Bloqueio por empreendimento (id do centro de custo). Hoje tudo liberado.\nconst regrasPorCentroCusto = {\n  // 'ID_DO_CENTRO_DE_CUSTO': { empreendimento: 'NOME', cobranca: false, motivo: '...' },\n};\n\n// Exceções por cliente (nome em MAIÚSCULAS, sem acento não é necessário: compara pelo nome inteiro)\nconst excecoesClientes = {\n  'SILVIA CARLA GOMES TARGINO': { cobranca: false, motivo: 'em negociacao' },\n};\n\n// ---------------------------------------------------------------------\n// Histórico de envios (vem do node Postgres \"Historico Ja Enviados Mario\")\n// ---------------------------------------------------------------------\nlet registros;\ntry {\n  registros = $('Historico Ja Enviados Mario').first().json.enviados;\n} catch (e) {\n  registros = undefined;\n}\nif (!Array.isArray(registros)) {\n  // TRAVA: sem histórico não enviamos nada (evita duplicados)\n  throw new Error('Histórico de envios indisponível: confira o node Historico Ja Enviados Mario.');\n}\nconst up = (s) => String(s || '').trim().toUpperCase();\nconst chave = (cliente, empreendimento, venc, tipo) => `${up(cliente)}|${up(empreendimento)}|${venc}|${tipo}`;\nconst jaEnviados = new Set(registros.map((r) => chave(r.cliente, r.empreendimento, r.venc, r.tipo)));\n\n// ---------------------------------------------------------------------\nconst hoje = new Date();\nhoje.setHours(0, 0, 0, 0);\n\nconst tipoPorDiferenca = (diff) => {\n  if (diff <= DIAS_ANTES && diff >= DIAS_ANTES - DIAS_RETENTATIVA) return 'ENVIO_BOLETO';\n  if (diff === 0) return 'LEMBRETE_VENCIMENTO';\n  if (diff === -1) return 'COBRANCA_ATRASO';\n  return null;\n};\n\nconst candidatos = [];\nconst todosOsItens = $input.all();\n\nfor (let indice = 0; indice < todosOsItens.length; indice++) {\n  const conta = todosOsItens[indice].json;\n\n  const status = String(conta.status || '').toUpperCase();\n  const naoPago = Number(conta.nao_pago || 0);\n  // PENDING (ainda não venceu) e OVERDUE (já venceu); ignora pagas\n  if (!['PENDING', 'OVERDUE'].includes(status) || naoPago <= 0) continue;\n\n  const clienteId = conta.cliente?.id;\n  if (!clienteId) continue;\n  const nomeCliente = up(conta.cliente?.nome);\n\n  // Lê a data exata do texto, ignorando fuso horário\n  const partes = String(conta.data_vencimento).split('T')[0].split('-');\n  const dataVencimento = new Date(partes[0], partes[1] - 1, partes[2]);\n  dataVencimento.setHours(0, 0, 0, 0);\n  const diffDias = Math.round((dataVencimento.getTime() - hoje.getTime()) / 86400000);\n\n  const tipoMensagem = tipoPorDiferenca(diffDias);\n  if (!tipoMensagem) continue;\n\n  const centroCusto = Array.isArray(conta.centros_de_custo) ? conta.centros_de_custo[0] : null;\n  const centroCustoId = centroCusto?.id;\n  const centroCustoNome = centroCusto?.nome || 'SEM CENTRO DE CUSTO';\n\n  const regraCentroCusto = centroCustoId && regrasPorCentroCusto[centroCustoId]\n    ? regrasPorCentroCusto[centroCustoId]\n    : { empreendimento: centroCustoNome, cobranca: true };\n\n  const nomeExcecao = Object.keys(excecoesClientes).find((nome) => nomeCliente.includes(nome));\n  const regraCliente = nomeExcecao ? excecoesClientes[nomeExcecao] : null;\n  let podeCobrar = regraCentroCusto.cobranca;\n  if (regraCliente) podeCobrar = regraCliente.forcar ? true : regraCliente.cobranca;\n  if (!podeCobrar) continue;\n\n  const dataFormatada = dataVencimento.toLocaleDateString('pt-BR');\n\n  // Já enviado antes? (mesmo cliente + empreendimento + vencimento + tipo)\n  if (jaEnviados.has(chave(conta.cliente?.nome, regraCentroCusto.empreendimento, dataFormatada, tipoMensagem))) continue;\n\n  candidatos.push({\n    prioridade: tipoMensagem === 'ENVIO_BOLETO' ? 1 : 0, // lembrete e atraso não têm 2ª chance: vão primeiro\n    diffDias,\n    json: {\n      parcelaId: conta.id,\n      clienteId,\n      cliente: conta.cliente?.nome,\n      empreendimento: regraCentroCusto.empreendimento,\n      tipoMensagem,\n      dataVencimento: dataFormatada,\n      valor: naoPago,\n    },\n    pairedItem: { item: indice },\n  });\n}\n\n// Lembrete/atraso primeiro; depois boletos mais próximos do vencimento\ncandidatos.sort((a, b) => a.prioridade - b.prioridade || a.diffDias - b.diffDias || String(a.json.parcelaId).localeCompare(String(b.json.parcelaId)));\n\nreturn candidatos\n  .slice(0, MAX_POR_EXECUCAO)\n  .map(({ json, pairedItem }) => ({ json, pairedItem }));"
      },
